# Copia este archivo a .env y genera los secretos con:  ./scripts/generar-secretos.sh
# NUNCA subas el .env a Git.

# ---------- Seguridad ----------
JWT_SECRET=CAMBIAR_base64_de_64_bytes
INTERNAL_API_KEY=CAMBIAR_clave_larga_aleatoria
ENCRYPTION_KEY=CAMBIAR_base64_de_32_bytes
ADMIN_EMAIL=admin@academia.pe
ADMIN_PASSWORD=CambiaEsto2026
ADMIN_TELEFONO=51999999999
IP_LISTA_NEGRA=
MAX_RPM=120

# ---------- Infraestructura ----------
POSTGRES_PASSWORD=postgres_pass
MATRICULA_DB_PASSWORD=matricula_pass
PAGOS_DB_PASSWORD=pagos_pass
NOTIFICACIONES_DB_PASSWORD=notificaciones_pass
COMPROBANTES_DB_PASSWORD=comprobantes_pass
RABBIT_USER=cursos
RABBIT_PASSWORD=cursos_pass

# ---------- URLs ----------
FRONTEND_URL=http://localhost:4200
# URL publica del gateway (en desarrollo: la de ngrok, ej. https://abcd-1234.ngrok-free.app)
PUBLIC_URL=http://localhost:8080

# ---------- Correo (por defecto Mailpit; para Gmail ver la guia) ----------
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USER=
MAIL_PASSWORD=
MAIL_AUTH=false
MAIL_TLS=false
MAIL_FROM=Academia <no-responder@academia.pe>
EMPRESA_NOMBRE=Academia de Cursos S.A.C.
EMPRESA_RUC=20000000001

# ---------- Mercado Pago ----------
# mock = sin credenciales (se simula el pago) | real = API de Mercado Pago
MP_MODO=mock
MP_ACCESS_TOKEN=
MP_WEBHOOK_SECRET=

# ---------- WhatsApp Cloud API (Meta) ----------
# mock = los mensajes salen en el log | real = se envian de verdad
WA_MODO=mock
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_VERIFY_TOKEN=token-verificacion-academia
WA_APP_SECRET=
WA_USAR_PLANTILLAS=false
